# COMFEST'26 Vercel Environment Configuration

# Server-Side Admin Password (Default: DPSBK20)
# This password is never sent to the client browser and is verified securely on the server
ADMIN_PASSWORD=DPSBK20

# Optional: Session encryption secret
SESSION_SECRET=comfest26_secure_admin_jwt_salt_2026_dpsbk

# Optional Cloud Database (Turso / LibSQL / Neon Postgres) for persistent serverless storage:
# If not provided, falls back to persistent local SQLite / serverless /tmp with preloaded official seed data
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
